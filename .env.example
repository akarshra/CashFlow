# Backend URL used by the Angular frontend
API_BASE_URL=http://localhost:8080/api

# Google Gemini AI endpoint and API key
GEMINI_API_URL=https://api.google.com/gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL credentials for backend
SUPABASE_DB_HOST=localhost
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=expensetracker
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_database_password_here

# Redis cache settings for backend
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT token secret for backend authentication
JWT_SECRET=ReplaceWithSecureSecretKey
